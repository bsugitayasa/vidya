generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      Int                @id @default(autoincrement())
  email                   String             @unique
  password                String
  nama                    String
  role                    Role               @default(STAFF)
  createdAt               DateTime           @default(now())
  rabDibuat               RencanaAnggaran[]  @relation("RabDibuat")
  rabDisetujui            RencanaAnggaran[]  @relation("RabDisetujui")
  rabDitutup              RencanaAnggaran[]  @relation("RabDitutup")
  pencairanDibuat         PencairanDana[]    @relation("PencairanDibuat")
  pencairanDibatalkan     PencairanDana[]    @relation("PencairanDibatalkan")
  pengeluaranDibuat       PengeluaranRab[]   @relation("PengeluaranDibuat")
  pengeluaranDiverifikasi PengeluaranRab[]   @relation("PengeluaranDiverifikasi")
  pengeluaranDibatalkan   PengeluaranRab[]   @relation("PengeluaranDibatalkan")
  pengembalianDibuat      PengembalianDana[] @relation("PengembalianDibuat")
  pengembalianDibatalkan  PengembalianDana[] @relation("PengembalianDibatalkan")
  auditKeuangans          AuditKeuangan[]
}

model KonfigurasiAplikasi {
  id        Int      @id @default(autoincrement())
  kunci     String   @unique
  nilai     String
  label     String
  updatedAt DateTime @updatedAt
}

model ProgramAjahan {
  id                 Int               @id @default(autoincrement())
  kode               String            @unique
  nama               String
  deskripsi          String?
  puniaNormal        Int
  puniaPasangan      Int?
  isPasanganTersedia Boolean           @default(false)
  isAktif            Boolean           @default(true)
  urutan             Int               @default(0)
  kodeSertifikat     String?
  pinKoordinator     String?
  mataKuliahs        MataKuliah[]
  sisyaPrograms      SisyaProgram[]
  rencanaAnggarans   RencanaAnggaran[]
}

model SisyaProgram {
  id              Int           @id @default(autoincrement())
  sisyaId         Int
  programAjahanId Int
  isPasangan      Boolean       @default(false)
  puniaProgram    Int
  nomorRegistrasi String?
  createdAt       DateTime      @default(now())
  programAjahan   ProgramAjahan @relation(fields: [programAjahanId], references: [id])
  sisya           Sisya         @relation(fields: [sisyaId], references: [id])

  @@unique([sisyaId, programAjahanId])
}

model Sisya {
  id                  Int               @id @default(autoincrement())
  nomorPendaftaran    String            @unique
  namaLengkap         String
  tempatLahir         String
  tanggalLahir        DateTime
  jenisKelamin        JenisKelamin
  alamat              String
  noHp                String
  email               String?
  namaGriya           String
  namaDesa            String
  namaKabupaten       String?
  totalPunia          Int
  totalTerbayar       Int               @default(0)
  statusPembayaran    StatusPembayaran  @default(MENUNGGU_PEMBAYARAN)
  fileIdentitasPath   String?
  fileFotoPath        String?
  fileRekomendasiPath String?
  status              StatusSisya       @default(PENDING)
  tanggalDiksan       DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  absensiSisyas       AbsensiSisya[]
  pembayarans         Pembayaran[]
  programSisyas       SisyaProgram[]
  statusKelulusan     OverrideKelulusan @default(AUTO)
  prosesiKelulusan    ProsesiKelulusan?

  partnerId Int?   @unique
  partner   Sisya? @relation("PartnerRelation", fields: [partnerId], references: [id])
  partnerOf Sisya? @relation("PartnerRelation")
}

model Pembayaran {
  id           Int              @id @default(autoincrement())
  sisyaId      Int
  nominal      Int              @default(0)
  buktiPath    String
  status       StatusVerifikasi @default(MENUNGGU)
  keterangan   String?
  tanggalBayar DateTime         @default(now())
  verifiedAt   DateTime?
  createdAt    DateTime         @default(now())
  sisya        Sisya            @relation(fields: [sisyaId], references: [id])
}

model MataKuliah {
  id              Int           @id @default(autoincrement())
  kode            String        @unique
  nama            String
  sks             Int
  semester        Int
  programAjahanId Int
  programAjahan   ProgramAjahan @relation(fields: [programAjahanId], references: [id])
  sesiAbsensis    SesiAbsensi[]
}

model SesiAbsensi {
  id                Int                @id @default(autoincrement())
  mataKuliahId      Int
  tanggal           DateTime
  pertemuan         Int
  topik             String?
  narawakya         String?
  dokSisyaPath      String?
  dokNarawakPath    String?
  dokPanitiaPath    String?
  createdAt         DateTime           @default(now())
  absensiSisyas     AbsensiSisya[]
  kuesionerJawabans KuesionerJawaban[]
  analisisKuesioner AnalisisKuesioner?
  mataKuliah        MataKuliah         @relation(fields: [mataKuliahId], references: [id])
}

model KuesionerJawaban {
  id            Int         @id @default(autoincrement())
  sesiAbsensiId Int
  pesanKesan    String
  createdAt     DateTime    @default(now())
  sesiAbsensi   SesiAbsensi @relation(fields: [sesiAbsensiId], references: [id], onDelete: Cascade)

  @@index([sesiAbsensiId, createdAt])
}

model AnalisisKuesioner {
  id            Int         @id @default(autoincrement())
  sesiAbsensiId Int         @unique
  jumlahRespons Int
  sourceHash    String
  hasilAnalisis Json
  model         String
  promptVersion String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  sesiAbsensi   SesiAbsensi @relation(fields: [sesiAbsensiId], references: [id], onDelete: Cascade)
}

model AbsensiSisya {
  id            Int           @id @default(autoincrement())
  sesiAbsensiId Int
  sisyaId       Int
  status        StatusAbsensi
  keterangan    String?
  createdAt     DateTime      @default(now())
  sesiAbsensi   SesiAbsensi   @relation(fields: [sesiAbsensiId], references: [id])
  sisya         Sisya         @relation(fields: [sisyaId], references: [id])

  @@unique([sesiAbsensiId, sisyaId])
}

model KategoriKeuangan {
  id            Int              @id @default(autoincrement())
  kode          String           @unique
  nama          String
  deskripsi     String?
  isAktif       Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  itemAnggarans ItemAnggaran[]
  pengeluarans  PengeluaranRab[]
}

model AkunKas {
  id            Int                @id @default(autoincrement())
  kode          String             @unique
  nama          String
  tipe          TipeAkunKas
  namaBank      String?
  nomorRekening String?
  isAktif       Boolean            @default(true)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  pencairans    PencairanDana[]
  pengeluarans  PengeluaranRab[]
  pengembalians PengembalianDana[]
}

model RencanaAnggaran {
  id              Int                @id @default(autoincrement())
  nomorRab        String             @unique
  namaKegiatan    String
  programAjahanId Int?
  penanggungJawab String
  tujuan          String?
  tanggalMulai    DateTime
  tanggalSelesai  DateTime
  totalDiajukan   Decimal            @db.Decimal(18, 0)
  totalDisetujui  Decimal            @default(0) @db.Decimal(18, 0)
  status          StatusRab          @default(DRAFT)
  dokumenPath     String?
  catatan         String?
  revision        Int                @default(1)
  createdById     Int
  submittedAt     DateTime?
  approvedById    Int?
  approvedAt      DateTime?
  rejectedReason  String?
  closedById      Int?
  closedAt        DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  programAjahan   ProgramAjahan?     @relation(fields: [programAjahanId], references: [id], onDelete: Restrict)
  createdBy       User               @relation("RabDibuat", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy      User?              @relation("RabDisetujui", fields: [approvedById], references: [id], onDelete: Restrict)
  closedBy        User?              @relation("RabDitutup", fields: [closedById], references: [id], onDelete: Restrict)
  items           ItemAnggaran[]
  pencairans      PencairanDana[]
  pengeluarans    PengeluaranRab[]
  pengembalians   PengembalianDana[]

  @@index([status, createdAt])
  @@index([programAjahanId])
}

model ItemAnggaran {
  id              Int               @id @default(autoincrement())
  rabId           Int
  kategoriId      Int?
  uraian          String
  volume          Decimal           @db.Decimal(12, 2)
  satuan          String
  hargaSatuan     Decimal           @db.Decimal(18, 0)
  jumlahDiajukan  Decimal           @db.Decimal(18, 0)
  jumlahDisetujui Decimal           @default(0) @db.Decimal(18, 0)
  urutan          Int               @default(0)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  rab             RencanaAnggaran   @relation(fields: [rabId], references: [id], onDelete: Cascade)
  kategori        KategoriKeuangan? @relation(fields: [kategoriId], references: [id], onDelete: Restrict)
  pengeluarans    PengeluaranRab[]

  @@index([rabId, urutan])
}

model PencairanDana {
  id             Int                     @id @default(autoincrement())
  rabId          Int
  akunKasId      Int
  tanggal        DateTime
  nominal        Decimal                 @db.Decimal(18, 0)
  sumberDana     String
  nomorReferensi String?
  buktiPath      String?
  keterangan     String?
  status         StatusTransaksiKeuangan @default(AKTIF)
  createdById    Int
  cancelledById  Int?
  cancelledAt    DateTime?
  cancelReason   String?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  rab            RencanaAnggaran         @relation(fields: [rabId], references: [id], onDelete: Restrict)
  akunKas        AkunKas                 @relation(fields: [akunKasId], references: [id], onDelete: Restrict)
  createdBy      User                    @relation("PencairanDibuat", fields: [createdById], references: [id], onDelete: Restrict)
  cancelledBy    User?                   @relation("PencairanDibatalkan", fields: [cancelledById], references: [id], onDelete: Restrict)

  @@index([rabId, status])
}

model PengeluaranRab {
  id              Int                      @id @default(autoincrement())
  rabId           Int
  itemAnggaranId  Int?
  kategoriId      Int
  akunKasId       Int
  tanggal         DateTime
  uraian          String
  penerima        String?
  nominal         Decimal                  @db.Decimal(18, 0)
  metode          MetodePembayaranKeuangan
  nomorBukti      String?
  buktiPath       String?
  status          StatusPengeluaran        @default(MENUNGGU_VERIFIKASI)
  keterangan      String?
  allowOverBudget Boolean                  @default(false)
  overrideReason  String?
  createdById     Int
  verifiedById    Int?
  verifiedAt      DateTime?
  rejectedReason  String?
  cancelledById   Int?
  cancelledAt     DateTime?
  cancelReason    String?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  rab             RencanaAnggaran          @relation(fields: [rabId], references: [id], onDelete: Restrict)
  itemAnggaran    ItemAnggaran?            @relation(fields: [itemAnggaranId], references: [id], onDelete: Restrict)
  kategori        KategoriKeuangan         @relation(fields: [kategoriId], references: [id], onDelete: Restrict)
  akunKas         AkunKas                  @relation(fields: [akunKasId], references: [id], onDelete: Restrict)
  createdBy       User                     @relation("PengeluaranDibuat", fields: [createdById], references: [id], onDelete: Restrict)
  verifiedBy      User?                    @relation("PengeluaranDiverifikasi", fields: [verifiedById], references: [id], onDelete: Restrict)
  cancelledBy     User?                    @relation("PengeluaranDibatalkan", fields: [cancelledById], references: [id], onDelete: Restrict)

  @@index([rabId, status])
  @@index([kategoriId, tanggal])
}

model PengembalianDana {
  id             Int                     @id @default(autoincrement())
  rabId          Int
  akunKasId      Int
  tanggal        DateTime
  nominal        Decimal                 @db.Decimal(18, 0)
  nomorReferensi String?
  buktiPath      String?
  keterangan     String?
  status         StatusTransaksiKeuangan @default(AKTIF)
  createdById    Int
  cancelledById  Int?
  cancelledAt    DateTime?
  cancelReason   String?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  rab            RencanaAnggaran         @relation(fields: [rabId], references: [id], onDelete: Restrict)
  akunKas        AkunKas                 @relation(fields: [akunKasId], references: [id], onDelete: Restrict)
  createdBy      User                    @relation("PengembalianDibuat", fields: [createdById], references: [id], onDelete: Restrict)
  cancelledBy    User?                   @relation("PengembalianDibatalkan", fields: [cancelledById], references: [id], onDelete: Restrict)

  @@index([rabId, status])
}

model AuditKeuangan {
  id         Int      @id @default(autoincrement())
  entityType String
  entityId   Int
  action     String
  oldValue   Json?
  newValue   Json?
  reason     String?
  userId     Int
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId, createdAt])
  @@index([userId, createdAt])
}

enum Role {
  SUPER_ADMIN
  ADMIN
  BENDAHARA
  STAFF
}

enum StatusRab {
  DRAFT
  DIAJUKAN
  DISETUJUI
  DITOLAK
  DICAIRKAN_SEBAGIAN
  DICAIRKAN_PENUH
  REALISASI
  MENUNGGU_VERIFIKASI_LPJ
  PERLU_REVISI
  SELESAI
  DIBATALKAN
}

enum TipeAkunKas {
  KAS
  BANK
}

enum StatusTransaksiKeuangan {
  AKTIF
  DIBATALKAN
}

enum StatusPengeluaran {
  MENUNGGU_VERIFIKASI
  VERIFIKASI
  DITOLAK
  DIBATALKAN
}

enum MetodePembayaranKeuangan {
  TUNAI
  TRANSFER
  QRIS
  LAINNYA
}

enum StatusVerifikasi {
  MENUNGGU
  VERIFIKASI
  DITOLAK
}

enum JenisKelamin {
  LAKI_LAKI
  PEREMPUAN
}

enum StatusSisya {
  PENDING
  AKTIF
  MEDIKSA
  TIDAK_AKTIF
}

enum StatusPembayaran {
  MENUNGGU_PEMBAYARAN
  MENUNGGU_VERIFIKASI
  BELUM_LUNAS
  LUNAS
  DITOLAK
}

enum StatusAbsensi {
  HADIR
  IZIN
  SAKIT
  ALPHA
}

enum OverrideKelulusan {
  AUTO
  LULUS
  TIDAK_LULUS
}

model ProsesiKelulusan {
  id         Int      @id @default(autoincrement())
  sisyaId    Int      @unique
  waktuHadir DateTime @default(now())
  createdAt  DateTime @default(now())

  sisya Sisya @relation(fields: [sisyaId], references: [id])
}

model QrDocument {
  id              BigInt    @id
  token           String    @unique @db.VarChar(100)
  nomorSurat      String    @map("nomor_surat") @db.VarChar(200)
  keteranganSurat String    @map("keterangan_surat") @db.VarChar(200)
  tanggal         DateTime  @db.Date
  namaPejabat     String    @map("nama_pejabat") @db.VarChar(200)
  jabatan         String    @db.VarChar(200)
  namaPejabat2    String?   @map("nama_pejabat_2") @db.VarChar(200)
  jabatan2        String?   @map("jabatan_2") @db.VarChar(200)
  createdAt       DateTime  @default(now()) @map("created_at")
  modifiedBy      String?   @map("modified_by") @db.VarChar(200)
  modifiedAt      DateTime? @map("modified_at")

  @@map("qr_document")
}

model TemplatePenandatangan {
  id           Int      @id @default(autoincrement())
  namaTemplate String   @unique
  namaPejabat  String
  jabatan      String
  namaPejabat2 String?
  jabatan2     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
